# Assume 'seurat_obj' is an existing Seurat object containing single-cell RNA-seq data.
# Typically, row names of 'seurat_obj' are gene names and column names are cell barcodes.

# 1. Identify mitochondrial genes.
#    For human data, genes often start with "MT-"; for mouse it might be "mt-".
mt_genes <- grep("^MT-", rownames(seurat_obj), value = TRUE)

# 2. Calculate total mitochondrial counts per cell.
#    'counts' is a sparse matrix storing expressions: rows = genes, columns = cells
mt_counts_per_cell <- Matrix::colSums(seurat_obj@assays$RNA@counts[mt_genes, , drop = FALSE])

# 3. Store the mtDNA counts in the Seurat object's metadata.
seurat_obj$mt_counts <- mt_counts_per_cell

# 4. (Optional) Calculate percentage of mitochondrial transcripts per cell.
#    Seurat provides a built-in function for computing feature set percentages.
seurat_obj[["percent.mt"]] <- PercentageFeatureSet(seurat_obj, pattern = "^MT-")

